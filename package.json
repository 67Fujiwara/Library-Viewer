{
  "name": "library-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "STEP files → in-browser 3D library viewer (single HTML, no server)",
  "scripts": {
    "build": "python3 build.py",
    "sample": "node tools/make_sample_library.mjs",
    "test": "npm run test:step && npm run test:glb && npm run test:browser && npm run test:folder && npm run test:treeedit && npm run test:tags && npm run test:library && npm run test:autolib && npm run test:panels && npm run test:measure && npm run test:focus && npm run test:perf && npm run test:sample",
    "test:step": "python3 tools/gen_test_step.py test/out && node test/read_step.mjs",
    "test:glb": "node test/test_glb_zip.mjs && node test/fusion_glb_test.mjs",
    "test:browser": "node test/browser_test.mjs",
    "test:library": "node test/library_test.mjs",
    "test:autolib": "node test/autolib_test.mjs",
    "test:sample": "npm run sample -- --clean && node test/sample_library_test.mjs",
    "test:env": "node test/env_check.mjs",
    "test:panels": "node test/panels_test.mjs",
    "test:measure": "node test/measure_test.mjs",
    "test:focus": "node test/focus_test.mjs",
    "test:folder": "node test/folder_test.mjs",
    "test:treeedit": "node test/treeedit_test.mjs",
    "test:tags": "node test/tags_test.mjs",
    "test:perf": "python3 tools/gen_test_step.py --heavy 150 test/out/heavy.step && node test/perf_test.mjs"
  },
  "dependencies": {
    "occt-import-js": "0.0.23",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "playwright": "^1.50.1"
  }
}
